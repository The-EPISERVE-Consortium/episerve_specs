{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.episerve.zib.de/schemas/fdo/v1.json",
  "title": "EPISERVE FAIR Digital Object, version 1",
  "description": "The metadata record (<QID>.fdo.json) of an object on the EPISERVE platform: a raw or processed dataset, a model run or a benchmark. All of them share one envelope: a kernel (identifier, type, components), a schema.org profile and provenance. Full text: README.md of this spec.",
  "type": "object",
  "required": ["@context", "@id", "@type", "kernel", "profile", "provenance"],
  "properties": {
    "@context": {
      "description": "JSON-LD context; the FDO context comes first, followed by the prefixes schema, prov and fdo.",
      "type": "array",
      "minItems": 1,
      "prefixItems": [{ "const": "https://w3id.org/fdo/context/v1" }]
    },
    "@id": { "$ref": "#/$defs/qid", "description": "The object's QID; a raw dataset's carries the suffix -raw." },
    "@type": { "const": "DigitalObject" },
    "conformsTo": {
      "description": "Names this spec version. Optional: detection uses the DigitalObject @type and Dataset kernel type.",
      "anyOf": [
        { "$ref": "#/$defs/specReference" },
        { "type": "array", "contains": { "$ref": "#/$defs/specReference" } }
      ]
    },
    "kernel": { "$ref": "#/$defs/kernel" },
    "profile": { "$ref": "#/$defs/profile" },
    "provenance": { "type": "object" },
    "prov:wasGeneratedBy": {
      "description": "Model runs only: the activity that produced the object; names the provenance block.",
      "type": "object",
      "required": ["@id"],
      "properties": { "@id": { "type": "string", "minLength": 1 } }
    }
  },

  "if": {
    "anyOf": [
      { "required": ["prov:wasGeneratedBy"] },
      {
        "properties": {
          "provenance": {
            "type": "object",
            "required": ["@type"],
            "properties": { "@type": { "const": "prov:Activity" } }
          }
        },
        "required": ["provenance"]
      }
    ]
  },
  "then": {
    "required": ["prov:wasGeneratedBy"],
    "properties": { "provenance": { "$ref": "#/$defs/runProvenance" } }
  },
  "else": {
    "properties": { "provenance": { "$ref": "#/$defs/generationProvenance" } },
    "if": {
      "required": ["profile"],
      "properties": {
        "profile": {
          "type": "object",
          "anyOf": [
            { "required": ["episerveBenchmark"] },
            { "required": ["additionalType"], "properties": { "additionalType": { "const": "benchmarks" } } }
          ]
        }
      }
    },
    "then": {
      "properties": {
        "profile": { "required": ["episerveBenchmark", "accessRights"] },
        "provenance": {
          "required": ["prov:wasDerivedFrom"],
          "properties": {
            "prov:wasDerivedFrom": {
              "anyOf": [
                { "$ref": "#/$defs/benchmarkSource" },
                { "type": "array", "items": { "$ref": "#/$defs/benchmarkSource" } }
              ]
            }
          }
        }
      }
    },
    "else": {
      "if": { "required": ["@id"], "properties": { "@id": { "type": "string", "pattern": "-raw$" } } },
      "else": {
        "properties": {
          "provenance": {
            "required": ["prov:wasDerivedFrom"],
            "properties": {
              "prov:wasDerivedFrom": {
                "anyOf": [
                  { "$ref": "#/$defs/datasetSource" },
                  { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/datasetSource" } }
                ]
              }
            }
          }
        }
      }
    }
  },

  "$defs": {
    "specReference": {
      "anyOf": [
        { "const": "https://api.episerve.zib.de/schemas/fdo/v1.json" },
        {
          "type": "object",
          "required": ["@id"],
          "properties": { "@id": { "const": "https://api.episerve.zib.de/schemas/fdo/v1.json" } }
        }
      ]
    },
    "qid": { "type": "string", "pattern": "^Q[0-9]+(-raw)?$" },

    "identifiedObject": {
      "type": "object",
      "required": ["@id"],
      "properties": { "@id": { "type": "string", "minLength": 1 } }
    },
    "datasetSource": {
      "type": "object",
      "required": ["@id"],
      "properties": { "@id": { "$ref": "#/$defs/qid" } }
    },
    "benchmarkSource": {
      "description": "Older benchmarks can name source objects by bare QID.",
      "anyOf": [{ "$ref": "#/$defs/qid" }, { "$ref": "#/$defs/datasetSource" }]
    },
    "generationProvenance": {
      "required": ["prov:generatedAtTime", "prov:wasAttributedTo"],
      "properties": { "prov:generatedAtTime": { "$ref": "#/$defs/dateTime" } }
    },
    "runProvenance": {
      "required": ["@id", "@type", "prov:startedAtTime", "prov:endedAtTime", "prov:used", "prov:wasAssociatedWith"],
      "properties": {
        "@id": { "type": "string", "minLength": 1 },
        "@type": { "const": "prov:Activity" },
        "prov:startedAtTime": { "$ref": "#/$defs/dateTime" },
        "prov:endedAtTime": { "$ref": "#/$defs/dateTime" },
        "prov:used": { "type": "array", "items": { "$ref": "#/$defs/identifiedObject" } },
        "prov:wasAssociatedWith": { "$ref": "#/$defs/identifiedObject" }
      }
    },

    "kernel": {
      "type": "object",
      "required": ["@id", "digitalObjectType", "primaryIdentifier", "kernelVersion", "immutable", "modified", "fdo:hasComponent"],
      "properties": {
        "@id": { "$ref": "#/$defs/qid" },
        "digitalObjectType": {
          "const": "https://schema.org/Dataset",
          "description": "Every object on the platform is a set of files, so the type is Dataset; what kind of object it is shows in the profile and the provenance."
        },
        "primaryIdentifier": { "$ref": "#/$defs/qid" },
        "kernelVersion": { "const": "v1" },
        "immutable": { "type": "boolean", "description": "true for a finalized benchmark; false for the rest." },
        "modified": { "$ref": "#/$defs/timestamp" },
        "fdo:hasComponent": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } }
      }
    },

    "component": {
      "type": "object",
      "required": ["@id", "componentId"],
      "properties": {
        "@id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique within the object: '#<componentId>' next to a single file, or the file's path below the object ('components/...')."
        },
        "componentId": { "type": "string", "minLength": 1, "description": "The file name; what DOIP and the API address the component by." },
        "mediaType": { "type": "string", "pattern": "^[a-z]+/[A-Za-z0-9.+_-]+$" }
      }
    },

    "profile": {
      "type": "object",
      "required": ["@type", "@id", "name", "description"],
      "properties": {
        "@context": { "const": "https://schema.org/" },
        "@type": { "const": "Dataset" },
        "@id": { "$ref": "#/$defs/qid" },
        "name": { "type": "string", "minLength": 1 },
        "display_name": {
          "type": "string",
          "description": "The title shown in the catalog. Not a schema.org term; an EPISERVE addition that the catalog, the lineage and the theme read. Falls back to name."
        },
        "description": { "type": "string" },
        "url": { "type": "string", "description": "Where the data comes from (a dataset), or the model image (a model run); empty for a benchmark." },
        "additionalType": { "type": "string", "description": "The catalog category of a dataset (incidence, surveillance, ...), or 'benchmarks'." },
        "license": { "type": "string", "description": "A CKAN licence id such as cc-by." },
        "creditText": { "type": "string" },
        "accessRights": { "enum": ["open", "restricted"], "description": "restricted: files are served with a signed link only." },
        "distribution": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["contentUrl"],
            "properties": {
              "@type": { "const": "DataDownload" },
              "contentUrl": { "type": "string", "minLength": 1 },
              "contentSize": { "type": ["string", "integer"] },
              "encodingFormat": { "type": "string" }
            }
          }
        },
        "episerveBenchmark": { "$ref": "#/$defs/benchmark" }
      }
    },

    "benchmark": {
      "type": "object",
      "description": "The benchmark's identity, source commit and pinned files.",
      "required": ["id", "data_commit", "files"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "data_commit": { "type": "string", "minLength": 1 },
        "files": {
          "type": "object",
          "required": ["input", "reference"],
          "properties": {
            "input": { "$ref": "#/$defs/benchmarkDataFile" },
            "reference": { "$ref": "#/$defs/benchmarkDataFile" },
            "definition": { "$ref": "#/$defs/benchmarkFile" }
          }
        }
      }
    },
    "benchmarkFile": {
      "type": "object",
      "required": ["component", "sha256"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "media_type": { "type": "string" }
      }
    },
    "benchmarkDataFile": {
      "$ref": "#/$defs/benchmarkFile",
      "required": ["rows", "columns"],
      "properties": {
        "rows": { "type": "integer", "minimum": 0 },
        "columns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dateTime": { "type": "string", "format": "date-time" },
    "timestamp": {
      "$ref": "#/$defs/dateTime",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
